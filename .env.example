# Signing and notarization credentials for cutting a release.
# Copy to .env and fill in. .env is gitignored and must stay that way.

# Codesigning identity. The Team ID is enough as long as it matches exactly
# one certificate in the keychain; otherwise use the full name, e.g.
# "Developer ID Application: Example Inc (ABCDE12345)".
MAC_SIGN_IDENTITY=

# Apple ID used for notarization, its team, and an app-specific password
# generated at appleid.apple.com (not the account password).
APPLE_ID=
APPLE_TEAM_ID=
APPLE_APP_SPECIFIC_PASSWORD=
